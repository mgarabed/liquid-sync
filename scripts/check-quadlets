#!/usr/bin/env bash
# Regenerate the quadlets from compose.yaml with podlet, fail on any difference
# from the committed ones in deploy/quadlets/, then dry-run the committed ones
# with Podman's quadlet generator. See ADR 0001 (docs/decisions/).
set -euo pipefail

# Tooling images are pinned by digest (ADR 0001 Evidence); bump both together.
PODLET_IMAGE="ghcr.io/containers/podlet:v0.3.2@sha256:90cb8214ade9da09b5a8fd93da20f9bfcad5c3ae40093c95c31be8dce29fd22e"
PODMAN_IMAGE="quay.io/podman/stable:v6.1.3@sha256:1d280cfab8e4cdaa221229c121f681c67463fbd82ad2fa6d13fdcf91c6fc747e"

usage() {
  cat <<'EOF'
Usage: scripts/check-quadlets [--write] [--skip-if-no-podman] [--help]
       scripts/check-quadlets --lint-only <dir>

Regenerates the bundle from compose.yaml with podlet (the quadlets plus copies
of config/ and couchdb.env.example) and compares it with the committed
deploy/quadlets/. Then lints the committed bundle against the ADR 0003 layout
and quadlet promises, and validates it with `quadlet -dryrun -user`. Exits
non-zero on any difference or error.

  --write   Replace deploy/quadlets/ with a freshly generated bundle, then
            validate it. Use after editing compose.yaml, config/ or
            couchdb.env.example.
  --lint-only <dir>
            Only lint <dir> against ADR 0003, then exit. Needs no Podman.
  --skip-if-no-podman
            Exit 0 with a SKIPPED warning when Podman isn't installed or
            can't reach an engine; every other failure still fails.
  --help    Show this help.

Set PODMAN to the podman binary if it isn't on PATH
(the macOS .pkg installer puts it at /opt/podman/bin/podman).
EOF
}

die() { echo "check-quadlets: $*" >&2; exit 1; }

# Prints the values of Key= lines in a unit file, one per line. Keys are
# matched whole and line-anchored, so comments and longer keys never match.
unit_values() {
  awk -v k="$2" '
    { line = $0; sub(/^[ \t]+/, "", line) }
    line ~ /^[#;]/ { next }
    {
      i = index(line, "="); if (!i) next
      key = substr(line, 1, i - 1); sub(/[ \t]+$/, "", key)
      if (key != k) next
      v = substr(line, i + 1); sub(/^[ \t]+/, "", v); sub(/[ \t\r]+$/, "", v)
      print v
    }' "$1"
}

# Lints a bundle directory against the ADR 0003 layout rules and quadlet
# promises (0011 R5). Prints one "file: rule" line per violation to stderr and
# returns 1 if there are any. It checks only what the contract states.
lint_bundle() {
  local dir="${1%/}" f rel v name tag n_ports=0
  local -a errs=()
  err() { errs+=("$1: $2"); }

  while IFS= read -r -d '' f; do
    err "${f#"$dir/"}" "not a regular file or directory (no symlinks or other file types)"
  done < <(find "$dir" -mindepth 1 ! -type f ! -type d -print0)

  while IFS= read -r -d '' f; do
    rel="${f#"$dir/"}"
    case "$f" in
      *.kube|*.image|*.build|*.artifact)
        err "$rel" "unit type not allowed (only .container, .network, .volume, .pod)" ;;
    esac
  done < <(find "$dir" -type f -print0)

  while IFS= read -r -d '' f; do
    rel="${f#"$dir/"}"

    while IFS= read -r v; do
      n_ports=$((n_ports + 1))
      [ "$v" = 127.0.0.1:5984:5984 ] \
        || err "$rel" "PublishPort=$v not allowed (only 127.0.0.1:5984:5984)"
    done < <(unit_values "$f" PublishPort)

    [ -z "$(unit_values "$f" PodmanArgs)" ] || err "$rel" "PodmanArgs= not allowed"

    while IFS= read -r v; do
      case "$v" in
        *.network)
          [ -n "$(find "$dir" -type f -name "$v" -print -quit)" ] \
            || err "$rel" "Network=$v not allowed (no such .network file in the bundle)" ;;
        *) err "$rel" "Network=$v not allowed (only the bundle's own .network file)" ;;
      esac
    done < <(unit_values "$f" Network)

    while IFS= read -r v; do
      [ "$v" = couchdb.env ] || err "$rel" "EnvironmentFile=$v not allowed (only couchdb.env)"
    done < <(unit_values "$f" EnvironmentFile)

    while IFS= read -r v; do
      name="${v%%@*}"; name="${name##*/}"
      if [[ "$name" != *:* ]]; then
        err "$rel" "Image=$v has no tag"
      else
        tag="${name##*:}"
        [ "$tag" != latest ] || err "$rel" "Image=$v is tagged latest"
      fi
    done < <(unit_values "$f" Image)

    case "$f" in
      *.network)
        for v in Driver NetworkInterface Options; do
          [ -z "$(unit_values "$f" "$v")" ] || err "$rel" "$v= not allowed in a .network file (default bridge only)"
        done ;;
      *.volume)
        [ -n "$(unit_values "$f" VolumeName)" ] || err "$rel" "missing VolumeName=" ;;
      *.container)
        awk '
          /^[ \t]*\[/ { sec = $0; gsub(/[ \t\r]/, "", sec); next }
          sec == "[Install]" && /^[ \t]*WantedBy[ \t]*=/ {
            v = $0; sub(/^[^=]*=/, "", v); n = split(v, w, /[ \t\r]+/)
            for (i = 1; i <= n; i++) if (w[i] == "default.target") found = 1
          }
          END { exit !found }' "$f" \
          || err "$rel" "missing WantedBy=default.target under [Install]" ;;
    esac
  done < <(find "$dir" -type f \( -name '*.container' -o -name '*.network' \
    -o -name '*.volume' -o -name '*.pod' \) -print0 | sort -z)

  [ "$n_ports" -le 1 ] || err "(bundle)" "$n_ports PublishPort= lines (only one allowed)"

  [ "${#errs[@]}" -eq 0 ] && return 0
  printf 'check-quadlets: lint: %s\n' "${errs[@]}" >&2
  return 1
}

write=0
skip_if_no_podman=0
lint_only=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --write) write=1 ;;
    --skip-if-no-podman) skip_if_no_podman=1 ;;
    --lint-only)
      [ "$#" -ge 2 ] || { usage >&2; die "--lint-only needs a directory"; }
      lint_only="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
  shift
done

# Runs before the Podman check: linting needs no Podman.
if [ -n "$lint_only" ]; then
  [ -d "$lint_only" ] || die "--lint-only: '$lint_only' is not a directory"
  lint_bundle "$lint_only" || die "FAILED: lint"
  echo "check-quadlets: lint OK"
  exit 0
fi

PODMAN="${PODMAN:-podman}"

# Prints why Podman is unavailable and returns 0, or returns 1 when it's usable.
# Only these two cases may be skipped (0008 R3, R4): once Podman is reachable,
# any later failure must fail the check, flag or not.
podman_unavailable_reason() {
  if ! command -v "$PODMAN" >/dev/null 2>&1; then
    echo "podman not found ('$PODMAN'); set PODMAN or add it to PATH"
  elif ! "$PODMAN" info >/dev/null 2>&1; then
    echo "podman ('$PODMAN') can't reach an engine (is the Podman machine running?)"
  else
    return 1
  fi
}

# Runs before any staging, so a skip creates nothing.
if reason="$(podman_unavailable_reason)"; then
  if [ "$skip_if_no_podman" -eq 1 ]; then
    echo "check-quadlets: SKIPPED — $reason; the quadlet check did not run" >&2
    exit 0
  fi
  die "$reason"
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
committed="$root/deploy/quadlets"

# Both rm -rf calls below check their target first, so an empty or wrong
# variable can't point them anywhere else.

# The temp dir always lives under /tmp. Its resolved path is used, because on
# macOS /tmp links to /private/tmp and the Podman machine shares /private.
tmp_root="$(cd /tmp && pwd -P)"
tmp="$(mktemp -d "$tmp_root/check-quadlets.XXXXXX")"
tmp="$(cd "$tmp" && pwd -P)"

assert_tmp() {
  case "$tmp" in
    "$tmp_root"/check-quadlets.??????)
      [ -d "$tmp" ] && [ ! -L "$tmp" ] && return 0 ;;
  esac
  die "refusing to remove '$tmp': not a check-quadlets temp dir under $tmp_root"
}

# deploy/quadlets/ is removed only when it is this repo's quadlet directory (next
# to compose.yaml and this script) and holds nothing but what --write itself
# produces: top-level unit files and couchdb.env.example, and config/*.ini.
assert_committed() {
  [[ "$root" == /?* ]] && [ "$committed" = "$root/deploy/quadlets" ] \
    && [ -f "$root/compose.yaml" ] && [ -f "$root/scripts/check-quadlets" ] \
    || die "refusing to remove '$committed': not <repo>/deploy/quadlets"
  [ ! -L "$committed" ] || die "refusing to remove '$committed': it is a symlink"
  [ -d "$committed" ] || return 0
  local path rel
  while IFS= read -r -d '' path; do
    rel="${path#"$committed/"}"
    if [ -L "$path" ]; then
      die "refusing to remove '$committed': '$rel' is a symlink"
    elif [ -d "$path" ] && [ "$rel" = config ]; then
      continue
    elif [ -f "$path" ]; then
      case "$rel" in
        */*/*) ;;
        config/*.ini) continue ;;
        */*) ;;
        couchdb.env.example|*.container|*.network|*.volume|*.pod) continue ;;
      esac
    fi
    die "refusing to remove '$committed': it holds '$rel', which --write doesn't produce"
  done < <(find "$committed" -mindepth 1 -print0)
}

assert_tmp
cleanup() { assert_tmp && rm -rf "$tmp"; }
trap cleanup EXIT

# Stage only what podlet needs. The env file is the committed example under the
# real name, so the check never reads a real secret.
mkdir -p "$tmp/src/out"
cp "$root/compose.yaml" "$tmp/src/"
cp -R "$root/config" "$tmp/src/"
cp "$root/couchdb.env.example" "$tmp/src/couchdb.env"

# --install adds [Install] WantedBy=default.target. Without it quadlet never
# enables the units, so they don't start at boot under the lingering user.
if ! "$PODMAN" run --rm -v "$tmp/src:/w:Z" -w /w "$PODLET_IMAGE" \
    --file out --install compose compose.yaml >"$tmp/podlet.log" 2>&1; then
  cat "$tmp/podlet.log" >&2
  die "podlet failed to convert compose.yaml"
fi

# The bundle also carries copies of its sources of truth (ADR 0003 layout). The
# example is copied by its own name; the staged couchdb.env never enters out/.
cp -R "$tmp/src/config" "$tmp/src/out/config"
cp "$root/couchdb.env.example" "$tmp/src/out/couchdb.env.example"

failed=()

if [ "$write" -eq 1 ]; then
  assert_committed
  rm -rf "$committed"
  mkdir -p "$committed"
  cp -R "$tmp/src/out/." "$committed/"
  find "$committed" -type f | sort | while IFS= read -r f; do
    echo "check-quadlets: wrote ${f#"$root/"}"
  done
elif ! diff -r "$tmp/src/out" "$committed" >&2; then
  echo "check-quadlets: deploy/quadlets/ differs from podlet output; run scripts/check-quadlets --write and review the diff" >&2
  failed+=(diff)
fi

lint_bundle "$committed" || failed+=(lint)

# The dry-run runs even after a diff or lint failure, so all problems are reported.
mkdir -p "$tmp/q"
cp -R "$committed/." "$tmp/q/"
if ! "$PODMAN" run --rm -v "$tmp/q:/q:Z" -e QUADLET_UNIT_DIRS=/q "$PODMAN_IMAGE" \
    /usr/libexec/podman/quadlet -dryrun -user >"$tmp/dryrun.log" 2>&1; then
  # Show the generator's errors; fall back to the whole log if there are none.
  grep 'quadlet-generator' "$tmp/dryrun.log" >&2 || cat "$tmp/dryrun.log" >&2
  echo "check-quadlets: quadlet -dryrun -user rejected deploy/quadlets/" >&2
  failed+=(dry-run)
fi

[ "${#failed[@]}" -eq 0 ] || die "FAILED: ${failed[*]}"
echo "check-quadlets: OK"
