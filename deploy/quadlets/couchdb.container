[Container]
AutoUpdate=registry
ContainerName=liquid-sync-couchdb
Entrypoint=["/bin/sh","-c","cp /liquid-sync/config/*.ini /opt/couchdb/etc/local.d/ && exec tini -- /docker-entrypoint.sh /opt/couchdb/bin/couchdb"]
EnvironmentFile=couchdb.env
Image=docker.io/library/couchdb:3.5
Memory=512mb
Network=liquid-sync.network
PublishPort=127.0.0.1:5984:5984
Volume=couchdb-data:/opt/couchdb/data
Volume=./config:/liquid-sync/config:ro,Z

[Service]
Restart=always
